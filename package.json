{
  "name": "aurelia21",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "playwright test --config=tests/playwright.config.js",
    "test:headed": "playwright test --config=tests/playwright.config.js --headed",
    "shots": "SHOTS=${SHOTS:-./test-results/shots} sh -c 'mkdir -p $SHOTS && playwright test --config=tests/playwright.config.js --workers=1 shots.spec.js'"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@axe-core/playwright": "^4.10.2"
  }
}
